// Parameter carrier for UnderwaterRenderPass. Never attached to geometry.



// Adaptador de superficie planetaria: espectro de olas, costa y consultas inversas.
// La superficie y la niebla
// submarina (underwater.gdshader) incluyen este archivo, así que evalúan exactamente la misma
// superficie con los mismos uniforms. WaterHeightSampler.gd es la réplica CPU para física;
// cualquier cambio aquí debe reflejarse allí.






// Oleaje Gerstner (trocoidal): olas grandes con crestas afiladas.
 // longitud de onda de la ola principal (m)
     // Q: 0 = senoidal suave, 1 = cresta pinchada
 // eje de referencia del marco de olas (las olas viajan en su plano ecuatorial)

// --- Máscara de temporal ---------------------------------------------------------------------
// El clima sube el oleaje sobre un ÚNICO material para todo el planeta, así que sin esto una
// tormenta levanta olas de mar abierto también dentro de un lago y en la rompiente. La máscara sale
// del mapa mundial precomputado (PlanetWorldMap): solo los cuerpos marcados como océano o mar
// reciben temporal, y aun ahí entra progresivamente con la profundidad.
//
// Solo se enmascaran AMPLITUD y STEEPNESS. La velocidad y la longitud de onda tienen que seguir
// siendo globales: variarlas por posición cambia la fase entre vértices vecinos y raja la malla.
//
// Con storm_mask_enabled = false la exposición es 1 en todo el planeta, o sea el comportamiento de
// siempre. PlanetWorldMap.storm_exposure_local es la réplica CPU; cambiar una obliga a cambiar la otra.










// Oleaje al que vuelve el agua sin exposición. Lo escribe el WeatherController con los valores
// base del material, los de antes de aplicarle el evento de clima.



// Los mapas storm_* son en realidad el mapa mundial horneado (PlanetWorldMap) enchufado al agua:
// los comparten la máscara de temporal y las olas de orilla de más abajo.

// --- Hielo marino ------------------------------------------------------------------------------
// Donde hace frío el mar se hiela: sin oleaje (superficie, niebla submarina y flotación) y con la
// banquisa dibujada encima (water_shader). Es la misma función que climate_sea_ice_at de
// climate.gdshaderinc, repetida aquí con uniforms propios porque este archivo también se traduce al
// compute submarino (tools/water/build_underwater_shared.py), que no entiende globales ni el ruido
// del clima. Solo latitud y distancia a la costa: esto se evalúa decenas de veces por píxel.
// ClimateField.sea_ice_with es la réplica CPU; los valores los empuja PlanetLoader.
// x = |latitud| a la que empieza, y = |latitud| helada, z = grados que se adelanta junto a la costa,
// w = alcance de ese adelanto (m).



// shore_dist < 0 = sin dato de costa.
float sea_ice_fraction(vec3 local, float shore_dist) {
    if (!sea_ice_enabled) {
        return 0.0;
    }
    vec3 d = normalize(local);
    float lat = degrees(asin(clamp(abs(d.y), 0.0, 1.0)));
    float lon = atan(d.z, d.x);
    lat += sin(lon * 7.0) * 1.6 + sin(lon * 17.0 + 1.3) * 0.7;
    float coast = shore_dist >= 0.0
        ? (1.0 - smoothstep(sea_ice_params.w * 0.25, sea_ice_params.w, shore_dist)) * sea_ice_params.z
        : 0.0;
    return smoothstep(sea_ice_params.x, sea_ice_params.y, lat + coast);
}

// Misma convención equirect que WorldMapData.dir_to_uv.
vec2 world_map_uv(vec3 dir) {
    return vec2(fract(0.5 - atan(dir.z, dir.x) / 6.28318530718),
                acos(clamp(dir.y, -1.0, 1.0)) / 3.14159265359);
}

// Altura del terreno sobre el radio nominal en ese téxel. textureLod y no texture: esto se evalúa
// también en el vertex, donde no hay derivadas.
float world_map_ground(vec2 uv) {
    return storm_height_min + textureLod(storm_height_map, uv, 0.0).r * storm_height_range;
}

// Recibe la uv equirect y la altura del terreno ya resueltas: las olas de orilla necesitan las dos
// también, y calcularlas aquí otra vez costaba un atan+acos y una lectura de textura de más en cada
// evaluación. La niebla submarina llama a esto ~70 veces por píxel, así que se nota.
float storm_exposure(vec2 uv, float ground, out bool shore_allowed) {
    if (!storm_mask_enabled) {
        shore_allowed = true;
        return 1.0;
    }
    vec4 c = textureLod(storm_body_map, uv, 0.0);
    int id = int(round(c.r * 255.0))
        | (int(round(c.g * 255.0)) << 8)
        | (int(round(c.b * 255.0)) << 16)
        | (int(round(c.a * 255.0)) << 24);

    bool exposed = false;
    for (int i = 0; i < 8; i++) {
        if (i >= storm_body_count) break;
        if (floatBitsToInt(uw.data[27 + (i)].x) == id) {
            exposed = true;
            break;
        }
    }
    // Tierra es -1 = RGBA(255). Cerca de la costa el mapa grueso puede decir "tierra" aunque la
    // malla de agua visible siga bajo este vértice: es un dato incierto y NO debe cortar la ola.
    // Solo un id positivo conocido como lago/charca constituye una exclusión fiable.
    bool coarse_land = c.r > 0.998 && c.g > 0.998 && c.b > 0.998 && c.a > 0.998;
    shore_allowed = coarse_land || exposed;
    if (!exposed) {
        return 0.0;
    }

    return smoothstep(storm_depth_start, storm_depth_full, storm_sea_height - ground);
}

// --- Olas de orilla ---------------------------------------------------------------------------
// En la franja costera el oleaje deja de venir de mar abierto: llega siempre de frente a la playa,
// con las crestas paralelas al litoral. Aquí NO se calcula la refracción; sale gratis haciendo que
// la FASE de esta familia sea la distancia horneada al litoral (shore_offset_map, de
// WorldMapBaker.bake_shore_field). Esa distancia es un campo escalar global y continuo con
// gradiente de módulo 1, así que la longitud de onda no cambia con la posición —y la malla no se
// raja, que es lo que prohíbe variar velocidad y longitud por posición—; y como la ola viaja por
// -grad(distancia), viaja hacia la costa por construcción.
//
// Se mezcla con el oleaje de mar abierto por AMPLITUD, nunca por fase: interpolar dos fases mete un
// término de miles de radianes que destroza las crestas. Encaja justo en el hueco que deja
// storm_exposure(), que ya vale 0 por debajo de storm_depth_start.
//
// WaterHeightSampler._gerstner_disp es la réplica CPU; cambiar una obliga a cambiar la otra.

// xyz = dirección unitaria hacia tierra; w = distancia/fase firmada (+mar, -tierra). Tras el filtro,
// length(xyz) mide cuánto coinciden las direcciones vecinas sin contaminar la fase.





// El ancho de la franja costera lo decide la DISTANCIA al litoral (acotada por SHORE_RANGE),
// no la profundidad. Atarlo a la batimetría se probó y no vale aquí: este terreno cae al 15% contra
// la orilla —las plataformas terrestres van al 0,1-1%—, así que con cualquier umbral físico la
// rompiente se quedaba en una tira de 160 m y el kilómetro siguiente se lo comía el swell global,
// viajando en una sola dirección contra toda la costa. El mapa es demasiado grueso para usar su
// profundidad en la línea de agua. Se conserva el nombre de este uniform por compatibilidad, pero
// ahora controla el mínimo de metros desde el litoral en los que entra suavemente el desplazamiento.

     // tope del crecimiento por shoaling
    // cuánto calma las costas a sotavento del swell
// Hasta dónde se ven las olas de orilla, en metros. 0 = toda la franja horneada. Sirve para acercar
// la rompiente a la costa SIN rehornear con un SHORE_RANGE menor, que es peor: el campo se hornea a
// ~90 m por téxel, así que una franja de 150 m son téxel y medio y la geometría de las crestas sale
// cuantizada. Mejor hornear ancho y recortar aquí.

// Alcance con el que se horneó el campo (lo empuja PlanetLoader). Es el que manda si shore_reach
// vale 0, y hace falta aquí para poder dar forma a la transición sin rehornear.

// Qué fracción del alcance ocupa el degradado de entrada, medido desde fuera hacia la costa.
// 0.5 = la mitad exterior de la franja es transición. Subirlo difumina el corte entre mar adentro y
// zona costera; bajarlo lo concentra. Cuidado: la transición es donde conviven las dos familias, así
// que estirarla mucho reaparece el mar cruzado — se compensa bajando shore_handover.

// Cuánto se adelanta el apagado del mar abierto al encendido de la orilla. Con un relevo simétrico
// las dos familias valen 0.5 a la vez en toda la transición y sus crestas se cruzan: eso es el mar
// cruzado, y se ve como una cuadrícula de picos. Subirlo saca antes al mar abierto (menos cruce, a
// cambio de un valle de amplitud); bajarlo a 1 vuelve al relevo simétrico.

// Cuánto oleaje de mar abierto SOBREVIVE al relevo, solo en las octavas mucho más cortas que la ola
// de orilla. Sin esto la franja costera es una única ola de Gerstner —una longitud de onda, una
// dirección, una fase— y por muy bien que se mueva se lee como una plancha ondulada. El relevo tiene
// sentido para el swell largo, que refracta y cede el paso a la rompiente; el chop de viento es de
// generación local y existe también dentro de la bahía. Subirlo mucho reabre el mar cruzado que
// shore_handover existe para evitar, pero solo puede hacerlo a escalas ya muy separadas de la
// rompiente: las octavas comparables a shore_length siguen apagándose enteras.

                 // ver shore_debug_color

// shore_breakup(): dobla la cresta y la parte en tramos. Vive en su propio include para que pueda
// usarla un shader incapaz de traerse este archivo entero (aquí hay treinta uniforms). Su aporte al
// gradiente de la fase está acotado a ~0.45k, así que deforma la ola sin poder plegarla; el
// razonamiento está en ese archivo.
// Rotura de la ola de orilla: lo que impide que cada cresta sea la isolínea exacta del campo de
// distancia horneado, es decir una cinta perfectamente recta y de anchura constante durante
// kilómetros. Devuelve a la vez el desplazamiento de fase (dobla la cresta) y el factor de amplitud
// (la parte en gaps, y con ella la espuma, que solo aparece por encima de un umbral de cresta).
//
// Vive en su propio archivo para poder incluirla desde un shader que no pueda traerse
// gerstner_waves entero: allí hay treinta uniforms de mapas de temporal y campos de costa. Aquí no
// hay uniforms, solo la función, así que incluirla no cuesta nada.
//
// Tres escalas, todas atadas a la longitud de onda salvo la primera:
//   - envolvente larga (~350 m): agrupa la rompiente en tramos, un mismo trozo de playa rompe
//     fuerte y el de al lado flojo. Sus dos fases avanzan a ritmos incommensurables y lentísimos
//     (periodos de ~170 y ~240 s); sin ese término está congelada en world-space y el mismo tramo
//     rompe siempre igual.
//   - meandro (3λ y 1.5λ): dobla la línea de cresta. Es el único término que se ve como forma, y
//     por eso el que fija el presupuesto de gradiente, ver más abajo.
//   - celdas (4λ y 2.4λ): apagan la amplitud a trozos, que es lo que parte la cinta de espuma.
//
// Presupuesto de gradiente: un desplazamiento de fase añade a la fase total un gradiente de
// amplitud·(2π/periodo), o sea amplitud·λ/periodo veces k. Con 0.85 rad a 3λ y 0.25 rad a 1.5λ el
// peor caso suma ~0.45k: la longitud de onda local se comprime o estira hasta un ±45%, que es
// justo lo que se lee como vida, y queda lejos del 100% en el que la cresta se plegaría sobre sí
// misma. Subir esas amplitudes sin bajar el periodo rompe esa garantía.
//
// WaterHeightSampler._shore_breakup es la réplica CPU; cambiar una obliga a cambiar la otra.

#ifndef SHORE_BREAKUP_INC
#define SHORE_BREAKUP_INC

const float SHORE_BREAKUP_TAU = 6.28318530718;

// x = desplazamiento de fase en radianes; y = factor de amplitud en [0,1].
vec2 shore_breakup(vec3 local, float t, float wavelength) {
    float wl = max(wavelength, 1.0);

    vec3 p = local / 55.0;
    float a = sin(dot(p, vec3(0.73, 0.21, 0.65)) + t * 0.037);
    float b = sin(dot(p, vec3(-0.31, 0.88, 0.36)) * 1.37 + 1.7 - t * 0.026);
    float env = clamp(0.5 + a * 0.325 + b * 0.175, 0.0, 1.0);

    vec3 m1 = local * (SHORE_BREAKUP_TAU / (wl * 3.0));
    vec3 m2 = local * (SHORE_BREAKUP_TAU / (wl * 1.5));
    float w1 = sin(dot(m1, vec3(0.83, -0.28, 0.48)) + t * 0.19);
    float w2 = sin(dot(m2, vec3(-0.37, 0.62, 0.69)) + 1.3 - t * 0.31);

    vec3 c1 = local * (SHORE_BREAKUP_TAU / (wl * 4.0));
    float e1 = sin(dot(c1, vec3(0.29, 0.75, -0.60)) + t * 0.13);
    float e2 = sin(dot(c1, vec3(-0.71, 0.41, 0.57)) * 1.63 - t * 0.11);
    float cells = clamp(0.5 + e1 * 0.34 + e2 * 0.22, 0.0, 1.0);

    // Las dos envolventes pesan lo mismo y se suman ANTES del umbral, en vez de multiplicar dos
    // factores independientes: multiplicarlas encadena los mínimos y deja zonas de agua muerta.
    float packet = env * 0.5 + cells * 0.5;
    return vec2((env - 0.5) * 0.9 + w1 * 0.55 + w2 * 0.25, mix(0.25, 1.0, smoothstep(0.2, 0.8, packet)));
}

#endif


// Suma de olas de Gerstner planetarias. Cada dirección fija define un ecuador propio y la fase
// usa la distancia geodésica firmada a ese gran círculo. Así el gradiente espacial conserva
// módulo unitario y la longitud de onda permanece constante sobre la esfera.
// Devuelve el desplazamiento world-space y, por out_normal, la normal analítica. out_crest es la
// señal de cresta/pliegue en ~[0,1]: pica donde la ola se pincha (whitecap), para la espuma.
// min_length = longitud de onda mínima (m) que tiene sentido dibujar aquí; las octavas por debajo
// se desvanecen. 0 = sin LOD, evalúa todas.
// Todo lo que la superficie necesita del mapa mundial en un punto. Se resuelve UNA vez y se
// reutiliza: la inversión de punto fijo evalúa la superficie cuatro veces sobre puntos separados unos
// metros, y releer las texturas en cada una cuadruplicaría las lecturas para un dato que varía en
// decenas de metros. WaterHeightSampler ya muestreaba fuera de la iteración, así que esto además
// acerca CPU y GPU en vez de separarlas.
struct WaveContext {
    float exposure;
    vec4 shore_field;
    float shore_dist;
    float shore_quality;
    float shore_depth;
    float shore_gate;
    // Hielo marino 0..1: apaga el oleaje (ver sea_ice_fraction).
    float ice;
};

WaveContext wave_context(vec3 local) {
    WaveContext ctx;
    ctx.exposure = 1.0;
    ctx.shore_field = vec4(0.0);
    ctx.shore_dist = 0.0;
    ctx.shore_quality = 0.0;
    ctx.shore_depth = 0.0;
    ctx.shore_gate = 0.0;
    ctx.ice = 0.0;
    if (!storm_mask_enabled && !shore_waves_enabled) {
        ctx.ice = sea_ice_fraction(local, -1.0);
        return ctx;
    }

    // La uv equirect y la altura del terreno las comparten la máscara de temporal y las olas de
    // orilla: un solo atan+acos y una sola lectura para las dos.
    vec2 uv = world_map_uv(normalize(local));
    float ground = world_map_ground(uv);
    bool shore_allowed;
    ctx.exposure = storm_exposure(uv, ground, shore_allowed);

    // Un id interior confirmado bloquea esta familia. "Tierra" no: en el borde grueso del mapa
    // también puede significar agua visible y convertirlo en veto dibuja rectángulos de un téxel.
    if (shore_waves_enabled && shore_allowed) {
        ctx.shore_field = textureLod(shore_offset_map, uv, 0.0);
        ctx.shore_dist = abs(ctx.shore_field.w);
        ctx.shore_quality = clamp(length(ctx.shore_field.xyz), 0.0, 1.0);
        ctx.shore_depth = storm_sea_height - ground;
        if (ctx.shore_dist > 1.0) {
            float reach = shore_reach > 0.0 ? shore_reach : shore_range;
            ctx.shore_gate = 1.0
                - smoothstep(reach * (1.0 - shore_fade), reach, ctx.shore_dist);
        }
    }
    // Lagos y charcas (id interior confirmado, sin familia costera) cuentan como costa: se hielan
    // antes que el mar abierto, igual que los ríos y las bahías estrechas.
    float ice_shore = !shore_waves_enabled ? -1.0 : (shore_allowed ? ctx.shore_dist : 0.0);
    ctx.ice = sea_ice_fraction(local, ice_shore);
    return ctx;
}

// Twelve coherent, incommensurate modes: swell, cross sea and wind waves.
// No packet lattice or spatial averaging. CPU mirror: ocean_spectrum.gd.

const int OCEAN_MODES = 12;
const float OCEAN_LENGTHS[12] = float[](1.0,0.86,1.19,0.67,0.45,0.38,0.31,0.24,0.17,0.135,0.105,0.078);
const float OCEAN_HEIGHTS[12] = float[](0.72,0.42,0.32,0.28,0.24,0.19,0.15,0.12,0.09,0.065,0.045,0.03);
const float OCEAN_CHOP[12] = float[](0.42,0.18,0.10,0.07,0.05,0.04,0.035,0.03,0.025,0.02,0.015,0.015);
const float OCEAN_ANGLES[12] = float[](0.0,-0.27,0.33,-0.51,0.62,-0.73,0.91,-1.04,1.17,-1.31,1.43,-1.57);

mat3 ocean_outer(vec3 a, vec3 b) { return mat3(a*b.x,a*b.y,a*b.z); }
vec3 ocean_mode_direction(vec3 wind, int i) {
    vec3 side = normalize(cross(wind, abs(wind.y)<0.9 ? vec3(0,1,0) : vec3(1,0,0)));
    vec3 vertical = cross(wind,side);
    float angle = OCEAN_ANGLES[i]*spectrum_spread;
    // Small out-of-plane spread keeps wind detail present at the planet's poles.
    return normalize(wind*cos(angle)+side*sin(angle)+vertical*sin(float(i)*2.399)*0.28);
}
float ocean_phase(vec3 p, vec3 dir, float k, float t, int i) {
    return k*dot(p,dir)+t*wave_speed*sqrt(9.81*k)+float(i)*2.39996323;
}
float ocean_mode_gate(float wavelength, float amplitude, float min_length,
                      float ocean_weight, float depth) {
    float lod = min_length>0.0 ? smoothstep(min_length*0.5,min_length*1.5,wavelength) : 1.0;
    float chop = (1.0-smoothstep(shore_length*0.25,shore_length*0.75,wavelength))
        *clamp(depth*0.4/max(amplitude,0.01),0.0,1.0)*shore_chop;
    return max(ocean_weight,chop)*lod;
}
float ocean_horizontal(float a, float k, float steepness, float gate, int i) {
    // Total horizontal contraction is bounded below one, even if every phase aligns.
    return min(a*4.0, OCEAN_CHOP[i]/(1.1*k))*clamp(steepness,0.0,0.95)*gate;
}
struct OceanField {
    vec3 lateral;
    float height;
    mat3 derivative;
    vec3 slope;
};
OceanField ocean_field(vec3 p, vec3 wind, float t, float amplitude, float steepness,
                       float min_length, float ocean_weight, float depth) {
    OceanField field;
    field.lateral=vec3(0.0); field.height=0.0;
    field.derivative=mat3(0.0); field.slope=vec3(0.0);
    float h2=0.22*clamp(steepness,0.0,0.95);
    float h3=0.055*steepness*steepness;
    for(int i=0;i<OCEAN_MODES;i++) {
        float wavelength=max(wave_base_length*OCEAN_LENGTHS[i],1.0);
        float k=6.28318530718/wavelength;
        float gate=ocean_mode_gate(wavelength,amplitude,min_length,ocean_weight,depth);
        vec3 dir=ocean_mode_direction(wind,i);
        float phase=ocean_phase(p,dir,k,t,i);
        float s=sin(phase), c=cos(phase);
        float a=amplitude*OCEAN_HEIGHTS[i];
        float horizontal=ocean_horizontal(a,k,steepness,gate,i);
        float profile=s+h2*(2.0*s*s-1.0)+h3*(4.0*s*s*s-3.0*s);
        float derivative=c*(1.0+4.0*h2*s+h3*(12.0*s*s-3.0));
        field.height+=a*gate*profile;
        field.slope+=dir*(a*gate*k*derivative);
        field.lateral+=dir*(horizontal*c);
        field.derivative-=ocean_outer(dir,dir)*(horizontal*k*s);
    }
    return field;
}
vec3 ocean_tangent(vec3 tangent, vec3 radial, float radius, OceanField field) {
    vec3 dv=field.derivative*tangent;
    return tangent*(1.0+(field.height-dot(radial,field.lateral))/radius)
        +dv-radial*dot(radial,dv)
        +radial*(dot(field.slope,tangent)-dot(field.lateral,tangent)/radius);
}


vec3 gerstner_surface_differential(vec3 local, vec3 radial, float t, float min_length, WaveContext ctx,
                          out vec3 out_normal, out float out_crest, out vec3 du, out vec3 dv) {
    vec3 pole = dot(wave_pole,wave_pole)>0.0001 ? normalize(wave_pole) : vec3(0,1,0);
    vec3 gx = normalize(cross(pole, abs(pole.x)<0.9 ? vec3(1,0,0) : vec3(0,0,1)));
    vec3 gy = cross(pole,gx);
    vec2 bd = dot(wave_direction,wave_direction)>0.0001 ? normalize(wave_direction) : vec2(1,0);
    vec3 wind = gx*bd.x+gy*bd.y;
    vec3 swell_dir = -normalize(wind-radial*dot(wind,radial)+vec3(0.0000001));
    float presence_lod = min_length>0.0 ? smoothstep(min_length*0.5,min_length*1.5,shore_length) : 1.0;
    float shore_presence = ctx.shore_gate*smoothstep(1.0,max(shore_length*0.25,shore_depth_fade),ctx.shore_dist)*presence_lod;
    float ocean_weight = 1.0-smoothstep(0.0,shore_handover,shore_presence);
    float amp = max(mix(wave_calm_amplitude,wave_amplitude,ctx.exposure),0.0) * (1.0-ctx.ice);
    float steepness = mix(wave_calm_steepness,wave_steepness,ctx.exposure);
    OceanField field = ocean_field(local,wind,t,amp,steepness,min_length,ocean_weight,ctx.shore_depth);
    vec3 horiz = vec3(0.0);
    float vert = 0.0;
    vec3 grad = vec3(0.0);
    float n_up_sub = 0.0;
    vec3 shore_axis = vec3(0.0);
    if (shore_presence > 0.001) {
        // Gradiente de la distancia en el plano tangente: apunta mar adentro, y la ola viaja en
        // sentido contrario. Se reproyecta al plano del vértice porque el vector horneado es el
        // del centro del téxel, no el de aquí.
        vec3 seaward = ctx.shore_quality > 1e-4
            ? -ctx.shore_field.xyz / ctx.shore_quality : vec3(0.0);
        seaward -= radial * dot(seaward, radial);
        float seaward_len = length(seaward);
        seaward = seaward_len > 1e-4 ? seaward / seaward_len : vec3(0.0);

        // Shoaling (ley de Green, A ~ h^-1/4), acotado: sin tope la ola revienta en la orilla. La
        // referencia es media longitud de onda, que es la profundidad a la que una ola siente el
        // fondo de verdad. Una profundidad errónea solo puede alterar este realce acotado; ya no
        // puede decidir si la familia costera existe o no.
        float shoal_raw = clamp(
            pow(max(ctx.shore_depth, 0.5) / max(shore_length * 0.5, 1.0), -0.25),
            1.0, shore_shoal_max);
        // En canales estrechos la batimetría gruesa suele decir "casi cero" y disparar el shoaling
        // al máximo. Solo se acepta ese realce donde la dirección costera es coherente; siempre se
        // conserva al menos la amplitud base.
        float shoal = mix(1.0, shoal_raw, ctx.shore_quality);
        // Incidencia: una costa de espaldas al swell rompe menos que una de cara, pero NUNCA hasta
        // cero. Antes se apagaba del todo y las playas a sotavento se quedaban en agua muerta;
        // en la realidad les llega oleaje difractado, más pequeño.
        float lee_target = mix(0.35, 1.0,
            smoothstep(-0.9, 0.6, dot(swell_dir, -seaward)));
        float lee = mix(1.0, lee_target, shore_incidence * ctx.shore_quality);
        float w = shore_presence * lee * (1.0-ctx.ice);

        float k = 6.28318530718 / max(shore_length, 0.1);
        // amp_ref va SIN el peso: la Q de Gerstner se normaliza contra la amplitud y se cancelaría
        // con ella, dejando arrastre horizontal donde la ola ya no existe. El peso escala después
        // los cuatro acumuladores, y así el término se apaga de verdad.
        // Límite geométrico de rompiente: H/L ~ 0.16 como máximo. El mapa de profundidad grueso
        // puede disparar shoal al tope; sin este límite A=5 m y L=20 m generaban paredes de 10 m.
        float amp_ref = min(shore_amplitude * shoal, shore_length * 0.08);
        float q = shore_steepness / max(k * amp_ref, 1e-4);
        // W es firmada: incluso si el litoral grueso coloca este vértice visible en su lado tierra,
        // su gradiente sigue apuntando mar adentro y la fase avanza siempre hacia tierra.
        vec2 breakup = shore_breakup(local, t, shore_length);
        float phase = k * ctx.shore_field.w + t * shore_speed * sqrt(k) + breakup.x;
        // La superficie nunca queda inmóvil, pero el tramo débil cae por debajo del umbral de
        // espuma y corta visualmente la cinta continua.
        w *= breakup.y;
        float cs = cos(phase);
        float sn = sin(phase);

        // En el eje de un estrecho las direcciones de ambas riberas se oponen. Reducir solo el
        // arrastre horizontal evita que la malla se pliegue en picos; altura y cresta siguen vivas.
        shore_axis = seaward;
        horiz += q * amp_ref * seaward * cs * w * ctx.shore_quality;
        vert += amp_ref * sn * w;
        grad += seaward * (k * amp_ref * cs) * w * ctx.shore_quality;
        n_up_sub += q * k * amp_ref * sn * w;
    }

    field.lateral += horiz;
    field.height += vert;
    field.slope += grad;
    field.derivative -= n_up_sub*ocean_outer(shore_axis,shore_axis);
    float radius = max(length(local),1.0);
    vec3 u = normalize(cross(radial,abs(radial.x)<0.9 ? vec3(1,0,0) : vec3(0,1,0)));
    vec3 v = cross(radial,u);
    du = ocean_tangent(u,radial,radius,field);
    dv = ocean_tangent(v,radial,radius,field);
    vec3 area = cross(du,dv);
    out_normal = normalize(area);
    out_crest = max(1.0-dot(area,radial)/pow(1.0+field.height/radius,2.0),0.0)*1.25;
    return field.lateral-radial*dot(radial,field.lateral)+radial*field.height;
}

vec3 gerstner_surface_ctx(vec3 local, vec3 radial, float t, float min_length, WaveContext ctx,
                          out vec3 out_normal, out float out_crest) {
    vec3 du;
    vec3 dv;
    return gerstner_surface_differential(local,radial,t,min_length,ctx,out_normal,out_crest,du,dv);
}

vec3 swell_direction(vec3 radial) {
    vec3 pole = dot(wave_pole,wave_pole)>0.0001 ? normalize(wave_pole) : vec3(0,1,0);
    vec3 gx = normalize(cross(pole, abs(pole.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 0.0, 1.0)));
    vec3 gy = cross(pole, gx);
    vec2 bd = (abs(wave_direction.x) + abs(wave_direction.y) < 1e-4)
        ? vec2(1.0, 0.0) : normalize(wave_direction);
    vec3 dir_fixed = normalize(gx * bd.x + gy * bd.y);
    vec3 dir_tan = dir_fixed - radial * dot(dir_fixed, radial);
    float tan_len = length(dir_tan);
    return tan_len > 1e-4 ? -dir_tan / tan_len : vec3(0.0);
}

// Vista de depuración del campo de orilla, para localizar dónde falla sin ir a ciegas. Pinta el
// agua plana con el valor crudo del campo; devuelve negro donde no hay dato.
//   1 cobertura/calidad de dirección           2 fase: bandas de una longitud de onda, enseñan
//                                                hacia dónde miran las crestas
//   3 sentido de viaje CONTRA la batimetría:   4 relevo entre familias: rojo = manda el oleaje de
//     verde = la ola avanza hacia donde el        mar abierto, verde = manda la orilla
//     fondo sube; rojo = va al revés            5 amplitud final relativa de la orilla
vec3 shore_debug_color(vec3 local, float t) {
    vec3 d = normalize(local);
    vec2 uv = world_map_uv(d);
    vec4 field = textureLod(shore_offset_map, uv, 0.0);
    float dist = abs(field.w);
    float quality = clamp(length(field.xyz), 0.0, 1.0);
    if (shore_debug_mode == 1) {
        float coverage = 1.0 - smoothstep(shore_range * 0.75, shore_range, dist);
        return vec3(coverage, quality, step(0.999, quality));
    }
    if (dist <= 1.0) {
        return vec3(0.0);
    }

    vec3 seaward = quality > 1e-4 ? -field.xyz / quality : vec3(0.0);
    seaward -= d * dot(seaward, d);
    float seaward_len = length(seaward);
    seaward = seaward_len > 1e-4 ? seaward / seaward_len : vec3(0.0);
    float shoreline_fade = smoothstep(1.0, max(shore_length * 0.25, shore_depth_fade), dist);

    if (shore_debug_mode == 2) {
        float k = 6.28318530718 / max(shore_length, 0.1);
        vec2 breakup = shore_breakup(local, t, shore_length);
        float band = fract((k * field.w + t * shore_speed * sqrt(k)
            + breakup.x) / 6.28318530718);
        return mix(vec3(0.05, 0.1, 0.25), vec3(1.0), step(0.5, band));
    }
    if (shore_debug_mode == 3) {
        // Sonda independiente del campo: si la ola viaja bien, el terreno sube en esa dirección.
        float rise = world_map_ground(world_map_uv(normalize(local - seaward * 300.0)))
                   - world_map_ground(uv);
        return mix(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), smoothstep(-2.0, 2.0, rise));
    }
    float reach = shore_reach > 0.0 ? shore_reach : shore_range;
    float gate = 1.0 - smoothstep(reach * (1.0 - shore_fade), reach, dist);
    if (shore_debug_mode == 4) {
        return mix(vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), gate);
    }
    float lee = mix(1.0, mix(0.35, 1.0, smoothstep(-0.9, 0.6, dot(swell_direction(d), -seaward))),
                    shore_incidence);
    float packet = shore_breakup(local, t, shore_length).y;
    return vec3(gate * shoreline_fade * lee * packet);
}

// Resuelve el mapa por su cuenta. Es la entrada normal desde el vertex del agua, que evalúa un
// punto distinto por vértice y no puede reaprovechar nada.
vec3 gerstner_surface_lod(vec3 local, vec3 radial, float t, float min_length,
                          out vec3 out_normal, out float out_crest) {
    return gerstner_surface_ctx(local, radial, t, min_length, wave_context(local),
                                out_normal, out_crest);
}

// Wrapper sin LOD ni señal de cresta: evalúa todos los modos del espectro. Lo usan la línea de flotación y la
// niebla submarina, que muestrean junto a la cámara y no pueden desviarse del sampler de CPU.
vec3 gerstner_surface(vec3 local, vec3 radial, float t, out vec3 out_normal) {
    float unused_crest;
    return gerstner_surface_lod(local, radial, t, 0.0, out_normal, unused_crest);
}

// Desplazamiento radial Y normal de la superficie sobre la dirección de 'local', invirtiendo por
// Newton el arrastre horizontal — mismo esquema que WaterHeightSampler.get_height_at.
// Ambos salen del mismo punto invertido: la normal evaluada en 'local' sin invertir pertenece a
// otra fase de la ola y desalinea el corte de la línea de flotación.
float gerstner_surface_height_normal(vec3 local, float t, out vec3 out_normal) {
    // El mapa se resuelve UNA vez para las cuatro evaluaciones. El punto fijo mueve el punto unos
    // metros y estos datos varían en decenas, así que la diferencia no se aprecia y ahorra tres
    // cuartas partes de las lecturas — que aquí pesan, porque la marcha de rayos de la niebla submarina
    // llama a esta función decenas de veces por píxel. Es además lo que ya hacía WaterHeightSampler.
    float radius = water_radius>0.0 ? water_radius : length(local);
    vec3 target = normalize(local)*radius;
    WaveContext ctx = wave_context(target);
    float unused_crest;
    vec3 guess = target;
    vec3 target_up = normalize(target);
    vec3 target_u = normalize(cross(target_up,abs(target_up.x)<0.9 ? vec3(1,0,0) : vec3(0,1,0)));
    vec3 target_v = cross(target_up,target_u);
    for (int i = 0; i < 4; i++) {
        vec3 radial = normalize(guess);
        vec3 du;
        vec3 dv;
        vec3 disp = gerstner_surface_differential(guess,radial,t,0.0,ctx,out_normal,unused_crest,du,dv);
        vec3 residual = guess+disp-target;
        vec2 error = vec2(dot(residual,target_u),dot(residual,target_v));
        if (dot(error,error)<0.000025) { return length(guess+disp)-radius; }
        float a = dot(du,target_u);
        float b = dot(dv,target_u);
        float c = dot(du,target_v);
        float d = dot(dv,target_v);
        float det = a*d-b*c;
        vec3 u = normalize(cross(radial,abs(radial.x)<0.9 ? vec3(1,0,0) : vec3(0,1,0)));
        vec3 v = cross(radial,u);
        if (det>0.05) {
            vec3 shift = (u*(d*error.x-b*error.y)+v*(a*error.y-c*error.x))/det;
            shift *= min(1.0,max(wave_base_length*0.4,1.0)/max(length(shift),0.001));
            guess = normalize(guess-shift)*radius;
        } else {
            guess = normalize(target-(disp-radial*dot(disp,radial)))*radius;
        }
    }
    vec3 radial = normalize(guess);
    return length(guess+gerstner_surface_ctx(guess,radial,t,0.0,ctx,out_normal,unused_crest))-radius;
}

// Wrapper solo-altura para los callers que no necesitan la normal.
float gerstner_surface_height(vec3 local, float t) {
    vec3 unused_normal;
    return gerstner_surface_height_normal(local, t, unused_normal);
}

// Niebla submarina compartida: la paleta de in-scatter por tramos de profundidad, el corte de la
// línea de flotación y el núcleo de la composición (absorción + in-scatter). Tres consumidores:
// underwater_optics.glslinc (compositor, con coeficientes propios de dispersión),
// water_shader.gdshader (solo el corte de flotación, para descartar su mitad sumergida) y
// glass_block.gdshader (niebla local de ventanas vistas desde compartimentos secos).







// Distancia con signo del punto del near plane a la línea de flotación: el plano local de la
// superficie sobre la cámara (a escala del near plane, ~10 cm, la ola es un plano).
// < 0 = ese píxel arranca bajo el agua. La usan water_shader (descarta su mitad sumergida)
// y underwater (descarta su mitad emergida): mismo test, mismos argumentos → partición
// píxel-exacta de la pantalla, sin rizados artificiales que desalineen el corte.
float waterline_signed(vec3 p_near_world, vec3 surface_point, vec3 surface_normal) {
    return dot(p_near_world - surface_point, surface_normal);
}

// Keep the centimetre-scale near offset out of the large planet coordinates.
// This order matches the compute compositor exactly, including at 30 km radii.
float waterline_signed_relative(vec3 camera_world, vec3 near_offset, vec3 surface_point, vec3 surface_normal) {
    return dot((camera_world - surface_point) + near_offset, surface_normal);
}

// Color de in-scatter según la profundidad (fog → deep → abyss).
vec3 depth_tier_color(float depth_meters) {
    if (depth_meters <= deep_transition_depth) {
        float t = clamp(depth_meters / deep_transition_depth, 0.0, 1.0);
        return mix(fog_color.rgb, deep_fog_color.rgb, t);
    } else if (depth_meters <= abyss_transition_depth) {
        float t = clamp((depth_meters - deep_transition_depth) / (abyss_transition_depth - deep_transition_depth), 0.0, 1.0);
        return mix(deep_fog_color.rgb, abyss_fog_color.rgb, t);
    }
    return abyss_fog_color.rgb;
}

// Distancia de salida del rayo de la esfera de radio r; -1.0 si no hay intersección delante.
// Vive aquí y no en underwater.gdshader porque la necesitan también las superficies transparentes
// que se nieblan solas (bloques de cristal sumergidos).
float ray_sphere_exit(vec3 center, float r, vec3 ro, vec3 rd) {
    vec3 oc = ro - center;
    float b = dot(oc, rd);
    float c = dot(oc, oc) - r * r;
    float disc = b * b - c;
    if (disc <= 0.0) {
        return -1.0;
    }
    return -b + sqrt(disc);
}

// Núcleo de la niebla submarina: absorción Beer-Lambert por canal más in-scatter. `column` son
// metros de agua atravesados y `scatter` el color de in-scatter ya iluminado. Lo comparten el compositor
// de pantalla completa y cualquier superficie transparente que tenga que nieblar lo que se ve a
// través de ella, que el compositor no cubre (ver cabecera).
vec3 underwater_apply(vec3 background, vec3 absorption, float column, vec3 scatter) {
    vec3 transmission = exp(-absorption * column);
    return background * transmission + scatter * (1.0 - transmission);
}

// Profundidad equivalente a la que converge el in-scatter de un rayo: la del observador, aclarada
// si mira hacia la superficie (up_amount = dot(rd, up) * 0.5 + 0.5) y hundida con la columna que
// el rayo acumula, porque el horizonte sumergido cae a deep/abyss.
float underwater_scatter_depth(float viewer_depth, float up_amount, float column,
        float vertical_range, float distance_gain, float distance_max) {
    return max(viewer_depth
        + mix(vertical_range, -vertical_range * 0.5, up_amount)
        + min(column * distance_gain, distance_max), 0.0);
}

// Cuánto espeja la cara inferior de la superficie para un rayo que la va a cruzar: 0 dentro de la
// ventana de Snell (el rayo escapa y se ve el cielo), 1 pasado el ángulo crítico (n = 1.333,
// cos ≈ 0.661), donde lo que se ve es agua profunda reflejada. El fundido ancho evita un borde
// duro en el anillo de Snell. `surface_normal` apunta hacia fuera del agua.
float underwater_tir_amount(vec3 rd, vec3 surface_normal) {
    return 1.0 - smoothstep(0.55, 0.72, dot(rd, surface_normal));
}

// Compartimentos SECOS de los barcos como OBBs: dentro no existe el agua (water_shader
// descarta superficie; underwater se descarta con la cámara dentro). GridManager los empuja
// por frame; underwater.gd los replica vía _SYNCED_WATER_PARAMS (el corte debe ir síncrono).

const int MAX_INTERIORS = 128;

 // xyz = centro de la caja en world
 // xyz = eje local X del casco, w = semieje



// true si el punto world cae dentro de algún compartimento seco.
bool inside_ship_interior(vec3 p) {
    for (int i = 0; i < MAX_INTERIORS; i++) {
        if (i >= interior_count) {
            break;
        }
        vec3 d = p - uw.data[63 + (i)].xyz;
        if (abs(dot(d, uw.data[191 + (i)].xyz)) < uw.data[191 + (i)].w
            && abs(dot(d, uw.data[319 + (i)].xyz)) < uw.data[319 + (i)].w
            && abs(dot(d, uw.data[447 + (i)].xyz)) < uw.data[447 + (i)].w) {
            return true;
        }
    }
    return false;
}







// Extinction separates absorption from suspended-particle scattering.


















// Metres along the underwater view ray at which surface projection falls to 1/e.


// Tamaño en metros de la ondulación del techo, relativo al detalle del material exterior.
// Por encima de 1 el techo es más liso que el mar visto desde arriba; por debajo, más picado.

// Fuerza de esa ondulación, independiente de normal_intensity, que la comparte el exterior.

// 0 reproduce la transición ancha anterior; 1 es el ángulo crítico real de Snell.

// The same animated detail maps used by the visible ocean surface.










// Multiplicador del tamaño de celda respecto a caustics_scale. Toca escala y scroll a la
// vez, así que cambia el grano sin cambiar la velocidad en metros por segundo.

// Sesgo sobre la velocidad de las cáusticas: 1.0 = exactamente su mismo movimiento.




// Ata los haces a la ola: la faceta encarada al sol transmite y la de canto no. Queda a 0
// por defecto porque los ata TAMBIÉN a su velocidad, y una ola de 60 m viaja a ~10 m/s. Con
// esto encendido no hay forma de que los haces se muevan despacio: o van a velocidad de ola,
// o el patrón de la textura se desliza contra ellos y eso es lo que se percibe como
// parpadeo. Las cuchillas ya las dibuja la textura a godray_pattern_scale 0.15.






// 0.7 apagaba las cáusticas en 1.4 m de profundidad; la superficie usa 0.22.












