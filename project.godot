[physics]

3d/physics_engine="Jolt Physics (Extension)"
jolt_physics_3d/limits/max_bodies=100240

[rendering]

textures/canvas_textures/default_texture_filter=3
gl_compatibility/nvidia_disable_threaded_optimization=false
environment/ssao/quality=3
environment/ssil/quality=3
textures/decals/filter=5
environment/screen_space_reflection/roughness_quality=2
environment/subsurface_scattering/subsurface_scattering_quality=2
lights_and_shadows/tighter_shadow_caster_culling=false
