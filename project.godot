[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/max_bodies=100240
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=3
textures/canvas_textures/default_texture_repeat=1
gl_compatibility/nvidia_disable_threaded_optimization=false
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=1
anti_aliasing/screen_space_roughness_limiter/enabled=false
textures/decals/filter=5
limits/spatial_indexer/threaded_cull_minimum_instances=1000000

[shader_globals]

u_world_offset={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
sky_sun_radiance={
"type": "vec3",
"value": Vector3(1, 0.95, 0.88)
}
sky_sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
