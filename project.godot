; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="VoxelTest"
run/main_scene="uid://8hm5q6k01tb8"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://wun7716afl1f"

[autoload]

GameManager="*uid://bn26i2o3uyxxf"
BlockDatabase="*uid://c3g5h784f1gjq"
GridManager="*uid://d2t2hkl7mbh3b"
Console="*res://scripts/console/console.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="VoxelTest"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/renderdoc_launcher/plugin.cfg")

